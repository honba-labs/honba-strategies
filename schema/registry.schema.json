{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/honba-labs/honba-strategies/schema/registry.schema.json",
  "title": "Honba strategy registry index schema",
  "description": "Schema for registry.json defining catalog strategy indexing and multi-version mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategies"],
  "properties": {
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "description", "tags"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "category": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "latest": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
          },
          "versions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "strategy_api_version"],
              "properties": {
                "path": { "type": "string" },
                "strategy_api_version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
                },
                "deprecated": { "type": "boolean" }
              }
            }
          }
        },
        "anyOf": [
          { "required": ["path"] },
          { "required": ["versions", "latest"] }
        ]
      }
    }
  }
}
